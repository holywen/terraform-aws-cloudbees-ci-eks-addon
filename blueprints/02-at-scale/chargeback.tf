# CHARGEBACK LAB (cur-kubecost-lab branch): AWS CUR 2.0 + Athena + Kubecost (EKS bundle).
#
# Showback lab for the PMI "Chargeback Modeling & Dashboards" plan (decision D4). Kubecost allocates
# cluster cost to namespaces/labels; the CUR 2.0 export, read through Athena, reconciles it to the bill.
#
# Notes:
# - The CUR 2.0 API exists only in us-east-1; the provider treats the service as global.
# - Split cost allocation data is not enabled: only payer or standalone accounts can opt in, and this
#   lab runs in a member account. Kubecost does not need it.
# - CUR data has no backfill. The first delivery can take up to 24 h, so the Glue crawler and
#   Kubecost reconciliation stay empty until then.

data "aws_caller_identity" "current" {}
data "aws_partition" "current" {}

locals {
  cb_account_id      = data.aws_caller_identity.current.account_id
  cb_cur_export_name = "${local.name}-cur2"
  cb_cur_prefix      = "cur"
  cb_glue_database   = replace("${local.name}_cur", "-", "_")
  # A crawler names the table after the last path segment ("data"); the prefix makes it unique.
  cb_glue_table_prefix = "cur2_"
  cb_athena_table      = "${local.cb_glue_table_prefix}data"
  cb_kubecost_ns       = "kubecost"
  # Service account of the kubecost-cloud-cost Deployment for release "kubecost" (chart 3.3.1).
  cb_kubecost_sa = "kubecost"
}

################################################################################
# CUR 2.0 export
################################################################################

resource "aws_s3_bucket" "cur" {
  bucket        = "${local.name}-cur-${local.cb_account_id}"
  force_destroy = true
  tags          = local.tags
}

resource "aws_s3_bucket_public_access_block" "cur" {
  bucket                  = aws_s3_bucket.cur.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_policy" "cur" {
  bucket = aws_s3_bucket.cur.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Sid       = "AllowDataExportsWrite"
      Effect    = "Allow"
      Principal = { Service = "bcm-data-exports.amazonaws.com" }
      Action    = ["s3:PutObject", "s3:GetBucketPolicy"]
      Resource  = [aws_s3_bucket.cur.arn, "${aws_s3_bucket.cur.arn}/*"]
      Condition = {
        StringLike = {
          "aws:SourceArn"     = "arn:${data.aws_partition.current.partition}:bcm-data-exports:us-east-1:${local.cb_account_id}:export/*"
          "aws:SourceAccount" = local.cb_account_id
        }
      }
    }]
  })
}

resource "aws_bcmdataexports_export" "cur2" {
  export {
    name = local.cb_cur_export_name
    data_query {
      # Column list generated by the AWS console for a CUR 2.0 export (114 columns).
      query_statement = trimspace(file("${path.module}/chargeback/cur2-query.sql"))
      table_configurations = {
        COST_AND_USAGE_REPORT = {
          BILLING_VIEW_ARN                      = "arn:${data.aws_partition.current.partition}:billing::${local.cb_account_id}:billingview/primary"
          TIME_GRANULARITY                      = "HOURLY"
          INCLUDE_RESOURCES                     = "TRUE"
          INCLUDE_SPLIT_COST_ALLOCATION_DATA    = "FALSE"
          INCLUDE_MANUAL_DISCOUNT_COMPATIBILITY = "FALSE"
        }
      }
    }
    destination_configurations {
      s3_destination {
        s3_bucket = aws_s3_bucket.cur.bucket
        s3_prefix = local.cb_cur_prefix
        s3_region = aws_s3_bucket.cur.region
        s3_output_configurations {
          overwrite   = "OVERWRITE_REPORT"
          format      = "PARQUET"
          compression = "PARQUET"
          output_type = "CUSTOM"
        }
      }
    }
    refresh_cadence {
      frequency = "SYNCHRONOUS"
    }
  }
  tags       = local.tags
  depends_on = [aws_s3_bucket_policy.cur]
}

################################################################################
# Glue catalog (crawler) and Athena
################################################################################

resource "aws_glue_catalog_database" "cur" {
  name = local.cb_glue_database
}

resource "aws_iam_role" "cur_crawler" {
  name = "${local.name}-cur-crawler"
  assume_role_policy = jsonencode({
    Version   = "2012-10-17"
    Statement = [{ Effect = "Allow", Principal = { Service = "glue.amazonaws.com" }, Action = "sts:AssumeRole" }]
  })
  tags = local.tags
}

resource "aws_iam_role_policy_attachment" "cur_crawler_service" {
  role       = aws_iam_role.cur_crawler.name
  policy_arn = "arn:${data.aws_partition.current.partition}:iam::aws:policy/service-role/AWSGlueServiceRole"
}

resource "aws_iam_role_policy" "cur_crawler_s3" {
  name = "cur-read"
  role = aws_iam_role.cur_crawler.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["s3:GetObject", "s3:ListBucket"]
      Resource = [aws_s3_bucket.cur.arn, "${aws_s3_bucket.cur.arn}/*"]
    }]
  })
}

resource "aws_glue_crawler" "cur" {
  name          = "${local.name}-cur2"
  database_name = aws_glue_catalog_database.cur.name
  role          = aws_iam_role.cur_crawler.arn
  table_prefix  = local.cb_glue_table_prefix
  schedule      = "cron(0 */6 * * ? *)"

  s3_target {
    path       = "s3://${aws_s3_bucket.cur.bucket}/${local.cb_cur_prefix}/${local.cb_cur_export_name}/data/"
    exclusions = ["**.json", "**.yml", "**.sql", "**.csv", "**.gz", "**.zip"]
  }

  schema_change_policy {
    update_behavior = "UPDATE_IN_DATABASE"
    delete_behavior = "DELETE_FROM_DATABASE"
  }

  tags = local.tags
}

resource "aws_s3_bucket" "athena_results" {
  bucket        = "${local.name}-athena-results-${local.cb_account_id}"
  force_destroy = true
  tags          = local.tags
}

resource "aws_s3_bucket_public_access_block" "athena_results" {
  bucket                  = aws_s3_bucket.athena_results.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_lifecycle_configuration" "athena_results" {
  bucket = aws_s3_bucket.athena_results.id
  rule {
    id     = "expire-query-results"
    status = "Enabled"
    filter {}
    expiration {
      days = 1
    }
  }
}

resource "aws_athena_workgroup" "kubecost" {
  name          = "${local.name}-kubecost"
  force_destroy = true
  configuration {
    result_configuration {
      output_location = "s3://${aws_s3_bucket.athena_results.bucket}/"
    }
  }
  tags = local.tags
}

################################################################################
# Kubecost (EKS bundle, chart 3.3.1) with Pod Identity for Athena
################################################################################

resource "aws_iam_role" "kubecost" {
  name = "${local.name}-kubecost"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "pods.eks.amazonaws.com" }
      Action    = ["sts:AssumeRole", "sts:TagSession"]
    }]
  })
  tags = local.tags
}

# Based on Kubecost's published policy for CUR + Athena + Glue + S3, scoped to the lab resources.
resource "aws_iam_role_policy" "kubecost" {
  name = "cur-athena"
  role = aws_iam_role.kubecost.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid      = "Athena"
        Effect   = "Allow"
        Action   = ["athena:StartQueryExecution", "athena:GetQueryExecution", "athena:GetQueryResults", "athena:GetWorkGroup"]
        Resource = aws_athena_workgroup.kubecost.arn
      },
      {
        Sid    = "Glue"
        Effect = "Allow"
        Action = ["glue:GetDatabase", "glue:GetDatabases", "glue:GetTable", "glue:GetTables", "glue:GetPartition", "glue:GetPartitions"]
        Resource = [
          "arn:${data.aws_partition.current.partition}:glue:${var.aws_region}:${local.cb_account_id}:catalog",
          "arn:${data.aws_partition.current.partition}:glue:${var.aws_region}:${local.cb_account_id}:database/${local.cb_glue_database}",
          "arn:${data.aws_partition.current.partition}:glue:${var.aws_region}:${local.cb_account_id}:table/${local.cb_glue_database}/*",
        ]
      },
      {
        Sid      = "AthenaResults"
        Effect   = "Allow"
        Action   = ["s3:GetObject", "s3:PutObject", "s3:ListBucket", "s3:GetBucketLocation", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"]
        Resource = [aws_s3_bucket.athena_results.arn, "${aws_s3_bucket.athena_results.arn}/*"]
      },
      {
        Sid      = "CurRead"
        Effect   = "Allow"
        Action   = ["s3:GetObject", "s3:ListBucket", "s3:GetBucketLocation", "s3:GetBucketAcl"]
        Resource = [aws_s3_bucket.cur.arn, "${aws_s3_bucket.cur.arn}/*"]
      },
    ]
  })
}

resource "aws_eks_pod_identity_association" "kubecost" {
  cluster_name    = module.eks.cluster_name
  namespace       = local.cb_kubecost_ns
  service_account = local.cb_kubecost_sa
  role_arn        = aws_iam_role.kubecost.arn
  tags            = local.tags
}

# gp3-a (the default class) is pinned to AZ a; the "shared" node group that runs Kubecost is not.
resource "kubernetes_storage_class_v1" "gp3_kubecost" {
  metadata {
    name = "gp3-kubecost"
  }
  storage_provisioner    = "ebs.csi.aws.com"
  allow_volume_expansion = true
  reclaim_policy         = "Delete"
  volume_binding_mode    = "WaitForFirstConsumer"
  parameters = {
    encrypted = "true"
    fsType    = "ext4"
    type      = "gp3"
  }
  depends_on = [module.eks]
}

resource "helm_release" "kubecost" {
  name             = "kubecost"
  repository       = "oci://public.ecr.aws/kubecost"
  chart            = "kubecost"
  version          = "3.3.1"
  namespace        = local.cb_kubecost_ns
  create_namespace = true
  timeout          = 900

  values = [
    file("${path.module}/k8s/kubecost-values.yml"),
    yamlencode({
      global = {
        clusterId           = module.eks.cluster_name
        defaultStorageClass = kubernetes_storage_class_v1.gp3_kubecost.metadata[0].name
      }
      cloudCost = {
        enabled = true
        # Schema of chart 3.3.1. No keys: the pod uses its Pod Identity credentials.
        cloudIntegrationJSON = jsonencode({
          aws = {
            athena = [{
              bucket     = "s3://${aws_s3_bucket.athena_results.bucket}"
              region     = var.aws_region
              database   = local.cb_glue_database
              table      = local.cb_athena_table
              workgroup  = aws_athena_workgroup.kubecost.name
              account    = local.cb_account_id
              authorizer = { authorizerType = "AWSServiceAccount" }
            }]
          }
        })
      }
    }),
  ]

  depends_on = [
    module.eks_blueprints_addons,
    aws_eks_pod_identity_association.kubecost,
    aws_iam_role_policy.kubecost,
  ]
}

################################################################################
# Outputs
################################################################################

output "kubecost_ui" {
  description = "Port-forward to the Kubecost UI, then open http://localhost:9090."
  value       = "kubectl port-forward -n ${local.cb_kubecost_ns} svc/kubecost-frontend 9090:9090"
}

output "cur2_export_arn" {
  description = "CUR 2.0 export ARN."
  value       = aws_bcmdataexports_export.cur2.id
}

output "cur2_s3_data_path" {
  description = "S3 path of the CUR 2.0 Parquet data read by the Glue crawler."
  value       = "s3://${aws_s3_bucket.cur.bucket}/${local.cb_cur_prefix}/${local.cb_cur_export_name}/data/"
}

output "cur2_athena_table" {
  description = "Athena database.table that Kubecost queries (created by the crawler after the first CUR delivery)."
  value       = "${local.cb_glue_database}.${local.cb_athena_table}"
}
