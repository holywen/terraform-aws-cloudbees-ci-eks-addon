{
  "uid": "showback-team",
  "title": "CloudBees CI showback - team",
  "description": "Showback for one team. Source: daily export in S3 (showback-allocated.csv).",
  "tags": [
    "showback",
    "cloudbees-ci"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "controller",
        "label": "Controller",
        "type": "query",
        "datasource": {
          "type": "grafana-athena-datasource",
          "uid": "showback-athena"
        },
        "refresh": 1,
        "sort": 1,
        "query": {
          "refId": "A",
          "datasource": {
            "type": "grafana-athena-datasource",
            "uid": "showback-athena"
          },
          "rawSQL": "SELECT DISTINCT controller_id FROM report_by_controller WHERE controller_id <> '__unallocated__' ORDER BY 1",
          "format": 1,
          "connectionArgs": {
            "region": "__default",
            "catalog": "__default",
            "database": "__default"
          }
        },
        "definition": "SELECT DISTINCT controller_id FROM report_by_controller",
        "current": {},
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Total cost",
      "description": "",
      "datasource": {
        "type": "grafana-athena-datasource",
        "uid": "showback-athena"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-athena-datasource",
            "uid": "showback-athena"
          },
          "rawSQL": "SELECT sum(total_cost) FROM report_by_controller WHERE date_parse(day, '%Y-%m-%d') BETWEEN date_trunc('day', $__timeFrom()) AND $__timeTo() AND controller_id = '$controller'",
          "format": 1,
          "connectionArgs": {
            "region": "__default",
            "catalog": "__default",
            "database": "__default"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Own cost",
      "description": "Controller and agent compute and storage.",
      "datasource": {
        "type": "grafana-athena-datasource",
        "uid": "showback-athena"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-athena-datasource",
            "uid": "showback-athena"
          },
          "rawSQL": "SELECT sum(controller_compute + controller_storage + agent_compute) FROM report_by_controller WHERE date_parse(day, '%Y-%m-%d') BETWEEN date_trunc('day', $__timeFrom()) AND $__timeTo() AND controller_id = '$controller'",
          "format": 1,
          "connectionArgs": {
            "region": "__default",
            "catalog": "__default",
            "database": "__default"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Share of platform cost",
      "description": "",
      "datasource": {
        "type": "grafana-athena-datasource",
        "uid": "showback-athena"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-athena-datasource",
            "uid": "showback-athena"
          },
          "rawSQL": "SELECT sum(shared_allocated) FROM report_by_controller WHERE date_parse(day, '%Y-%m-%d') BETWEEN date_trunc('day', $__timeFrom()) AND $__timeTo() AND controller_id = '$controller'",
          "format": 1,
          "connectionArgs": {
            "region": "__default",
            "catalog": "__default",
            "database": "__default"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
